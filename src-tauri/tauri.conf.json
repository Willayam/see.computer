{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "see.computer",
  "version": "0.1.3",
  "identifier": "computer.see.app",
  "mainBinaryName": "see-computer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pill",
        "url": "pill.html",
        "title": "",
        "width": 260,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true,
        "visible": false,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "focusable": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1QUIyNDFGRjNERjA5OTQKUldTVUNkL3pIeVNycFl4SUVyUWJuTU5Rb3N5Yk5lTW1hVXk5b3FPZVpUUmtFWnBrWmVJdGVaeEQK",
      "endpoints": [
        "https://github.com/Willayam/see.computer/releases/latest/download/latest.json"
      ]
    }
  }
}
